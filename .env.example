# Token do bot no Discord Developer Portal
# https://discord.com/developers/applications
DISCORD_TOKEN=

# Cookie do YouTube (necessário para streaming em cloud)
# Como obter:
#   1. Acesse youtube.com logado no navegador
#   2. Instale a extensão "Get cookies.txt LOCALLY" (Chrome/Firefox)
#   3. Exporte os cookies do youtube.com
#   4. Cole aqui o conteúdo completo da linha que contém "__Secure-1PSID"
#   Ou cole a string inteira de cookies no formato: "key=value; key2=value2"
YOUTUBE_COOKIE=
